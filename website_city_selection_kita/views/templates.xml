<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the website_sale address template to add city dropdown -->
    <template id="address" inherit_id="website_sale.address">
        <xpath expr="//input[@name='city']/parent::div" position="replace">
            <div t-attf-class="mb-3 #{error.get('city') and 'o_has_error' or ''} col-md-8 div_city">
                <label class="col-form-label" for="city">City</label>
                <t t-if="country and country.enforce_cities">
                    <input type="text" style="display: none;" t-attf-class="form-control #{error.get('city') and 'is-invalid' or ''}" name="city" t-att-value="'city' in checkout and checkout['city']" />
                    <select name="city_id" t-attf-class="form-select #{error.get('city') and 'is-invalid' or ''}" data-init="1">
                        <option value=""></option>
                        <t t-foreach="state_cities" t-as="c">
                            <option t-att-value="c.id" t-att-selected="c.id == ('city_id' in checkout and state and checkout['city_id'] != '' and int(checkout['city_id']))">
                                <t t-esc="c.name" />
                            </option>
                        </t>
                    </select>
                </t>
                <t t-else="">
                    <input type="text" name="city" t-attf-class="form-control #{error.get('city') and 'is-invalid' or ''}" t-att-value="'city' in checkout and checkout['city']" />
                    <select  style="display: none;"  name="city_id" t-attf-class="form-select #{error.get('city') and 'is-invalid' or ''}" data-init="1">
                        <option value=""></option>
                        <t t-foreach="state_cities" t-as="c">
                            <option t-att-value="c.id" t-att-selected="c.id == ('city_id' in checkout and state and checkout['city_id'] != '' and int(checkout['city_id']))">
                                <t t-esc="c.name" />
                            </option>
                        </t>
                    </select>
                </t>
            </div>
        </xpath>
    </template>
</odoo>

