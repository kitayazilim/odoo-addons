<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_method_paytr" model="payment.method">
        <field name="name">PayTR iFrame</field>
        <field name="code">paytr</field>
        <field name="sequence">1000</field>
        <field name="image" type="base64" file="payment_paytr_kt/static/description/paytr.svg"/>
        <field name="provider_id" ref="payment_paytr_kt.payment_provider_paytr"/>
        <field name="supported_country_ids" eval="[Command.set([ref('base.tr')])]"/>
        <field name="support_tokenization">False</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">none</field>
    </record>

</odoo>
