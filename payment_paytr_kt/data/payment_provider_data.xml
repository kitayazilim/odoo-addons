<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="payment_provider_paytr" model="payment.provider">
        <field name="name">PayTR iFrame</field>
        <field name="code">paytr</field>
        <field name="display_as">Credit Card (powered by PayTR)</field>
        <field name="module_id" ref="base.module_payment_paytr_kt"/>
        <field name="image_128" type="base64" file="payment_paytr_kt/static/description/paytr.svg"/>
        <field name="payment_icon_ids"
               eval="[(6, 0, [
                   ref('payment.payment_icon_cc_american_express'),
                   ref('payment.payment_icon_cc_visa'),
                   ref('payment.payment_icon_cc_mastercard'),
                   ref('payment.payment_icon_cc_unionpay'),
                   ref('payment_paytr_kt.payment_icon_cc_troy'),
               ])]"/>
    </record>

</odoo>
