<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">PayTR Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position='inside'>
                <group attrs="{'invisible': [('code', '!=', 'paytr')]}">
                    <field name="paytr_merchant_id" attrs="{'required':[ ('code', '=', 'paytr'), ('state', '!=', 'disabled')]}"/>
                    <field name="paytr_merchant_key"  attrs="{'required':[ ('code', '=', 'paytr'), ('state', '!=', 'disabled')]}"/>
                    <field name="paytr_merchant_salt"  attrs="{'required':[ ('code', '=', 'paytr'), ('state', '!=', 'disabled')]}" />
                </group>
            </group>
            <page name="configuration" position='inside'>
                <group attrs="{'invisible': [('code', '!=', 'paytr')]}">
                    <field name="paytr_no_installment"  attrs="{'required':[ ('code', '=', 'paytr'), ('state', '!=', 'disabled')]}" />
                    <field name="paytr_max_installment"  attrs="{'required':[ ('code', '=', 'paytr'), ('state', '!=', 'disabled')]}" />
                    <field name="paytr_timeout"  attrs="{'required':[ ('code', '=', 'paytr'), ('state', '!=', 'disabled')]}" />
                </group>
            </page>
        </field>
    </record>
</odoo>
