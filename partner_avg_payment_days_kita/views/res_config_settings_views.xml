<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.partner.avg.payment.days</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Ortalama Ödeme Günleri Hesaplama" id="partner_avg_payment_days_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="partner_avg_payment_days_from" string="Hesaplama Süresi" class="o_form_label"/>
                            <div class="text-muted">
                                    Ortalama ödeme günleri hesaplaması için geriye dönük gün sayısı
                            </div>
                            <div class="content-group mt16">
                                <field name="partner_avg_payment_days_from" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="partner_avg_payment_excluded_journal_id" string="Hariç Tutulacak Yevmiye" class="o_form_label"/>
                            <div class="text-muted">
                                Ortalama ödeme günleri hesaplamasından hariç tutulacak yevmiye
                            </div>
                            <div class="content-group mt16">
                                <field name="partner_avg_payment_excluded_journal_id"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="partner_avg_payment_sms_interval_days" string="Bilgilendirme Gönderim Sıklığı" class="o_form_label"/>
                            <div class="text-muted">
                                Aynı iş ortağına yeniden SMS ya da E-Mail göndermek için beklenecek minimum gün sayısı
                            </div>
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="partner_avg_payment_sms_interval_days" string="SMS" class="col-1 o_light_label"/>
                                    <field name="partner_avg_payment_sms_interval_days" style="width: 60px;"/>
                                    <label for="partner_avg_payment_email_interval_days" string="E-Mail" class="col-2 o_light_label"/>
                                    <field name="partner_avg_payment_email_interval_days" style="width: 60px;"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
