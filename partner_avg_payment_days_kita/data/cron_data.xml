<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Partner Ekleme Cron'u -->
        <record id="ir_cron_sync_partners" model="ir.cron">
            <field name="name">Partner Ortalama Vade Günleri: İş Ortaklarını Senkronize Et</field>
            <field name="model_id" ref="model_partner_avg_payment_days"/>
            <field name="state">code</field>
            <field name="code">model._sync_all_companies()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Hesaplama Cron'u -->
        <record id="ir_cron_calculate_avg_days" model="ir.cron">
            <field name="name">Partner Ortalama Vade Günleri: Ortalama Günleri Hesapla</field>
            <field name="model_id" ref="model_partner_avg_payment_days"/>
            <field name="state">code</field>
            <field name="code">model.cron_calculate_avg_days(50)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
